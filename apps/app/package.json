{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 9999 --strictPort",
    "check": "pnpm run format:check && pnpm run typecheck",
    "typecheck": "tsr generate && tsc --noEmit",
    "build": "vite build",
    "preview": "pnpm run build && vite preview --host 0.0.0.0 --port 9999 --strictPort",
    "deploy": "pnpm run check && pnpm run build && pnpm exec continual deploy",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@continual/sdk": "0.5.6",
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/react-router": "1.170.21",
    "@tanstack/react-start": "1.168.38",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@continual/cli": "0.5.13",
    "@continual/tanstack-start": "0.1.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@tanstack/router-cli": "1.167.34",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "playwright": "1.63.0",
    "shadcn": "4.7.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "continual": {
    "key": "app",
    "name": "App"
  }
}
